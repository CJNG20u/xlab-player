# MUSIC_DIR: Default NAS music mount path (can be changed anytime in Settings UI)
MUSIC_DIR="./music_library"

# JWT_SECRET: Secret key for signing auth sessions (auto-generated & persisted in SQLite if omitted)
JWT_SECRET=""

# YTDLP_PATH: Path to yt-dlp binary (defaults to "yt-dlp" on PATH)
YTDLP_PATH="yt-dlp"

# FFMPEG_PATH: Path to ffmpeg binary (defaults to "ffmpeg" on PATH)
FFMPEG_PATH="ffmpeg"

# PORT: Server port (defaults to 3000)
PORT="3000"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"
