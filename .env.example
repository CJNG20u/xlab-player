# =============================================================================
# xlabplayer Environment Configuration
# Copy this file to `.env` and adjust values for your deployment.
# =============================================================================

# HTTP server listening port (default: 3000)
PORT=3000

# Secret used to sign authentication JWTs (minimum 16 characters; 32+ recommended).
# Leave blank to auto-generate a secure random secret and persist it in SQLite,
# or generate one with: openssl rand -hex 32
JWT_SECRET=

# Set to true when serving xlabplayer over HTTPS behind a reverse proxy
# (Nginx, Caddy, Traefik, Cloudflare Tunnel) so session cookies get the Secure flag.
# Keep false for plain HTTP on a local LAN.
COOKIE_SECURE=false

# Directory for SQLite database (xlabplayer.db), extracted covers, and cookies.txt.
# Docker default: /app/data | Bare-metal default (when unset): ./data
DATA_DIR=/app/data

# Active music library root seeded on first boot (can also be updated in Settings).
# Docker default: /music | Bare-metal default (when unset): ./music_library
MUSIC_DIR=/music

# Path to the yt-dlp binary seeded on first boot.
# Docker default: /usr/local/bin/yt-dlp | Bare-metal default: yt-dlp
YTDLP_PATH=/usr/local/bin/yt-dlp

# Path to the ffmpeg binary seeded on first boot.
# Docker default: /usr/bin/ffmpeg | Bare-metal default: ffmpeg
FFMPEG_PATH=/usr/bin/ffmpeg

# Container runtime user/group IDs for NAS share file ownership (Docker only).
# Match your host/NAS share owner (check with `id -u` and `id -g`).
PUID=1000
PGID=1000

# =============================================================================
# YouTube Audio Stream Resolver Tuning & Optional PO Token Provider
# =============================================================================

# Persistent yt-dlp cache directory (stores solved JS player scripts across restarts).
# Defaults to ${DATA_DIR}/ytdlp-cache when unset.
YTDLP_CACHE_DIR=/app/data/ytdlp-cache

# Per-attempt resolver timeouts in milliseconds (clamped 10000-90000).
# Node EJS challenge solving on a small VPS can take 10-30s on cold cache.
YTDLP_RESOLVE_PRIMARY_TIMEOUT_MS=35000
YTDLP_RESOLVE_FALLBACK_TIMEOUT_MS=30000

# Maximum concurrent yt-dlp resolve child processes (default: 2, clamped 1-6).
YTDLP_MAX_CONCURRENT_RESOLVES=2

# Sliding-window per-strategy 403 circuit breaker.
# Opens a strategy's circuit ONLY when within YTDLP_CIRCUIT_WINDOW_MS:
#   successes === 0 AND failures >= YTDLP_CIRCUIT_MIN_FAILURES
#   AND distinct failing videoIds >= YTDLP_CIRCUIT_MIN_DISTINCT_VIDEOS.
YTDLP_CIRCUIT_WINDOW_MS=600000
YTDLP_CIRCUIT_COOLDOWN_MS=600000
YTDLP_CIRCUIT_MIN_FAILURES=5
YTDLP_CIRCUIT_MIN_DISTINCT_VIDEOS=3

# Per-video negative cache TTL in ms (videos that 403 on direct proxy go straight to pipe fallback).
YTDLP_VIDEO_NEG_CACHE_TTL_MS=900000

# TV ad-gate 403 polling retry settings (milliseconds).
# On a first-probe 403 for TV clients, re-probes the same URL every YT_AD_GATE_POLL_MS
# up to YT_AD_GATE_MAX_WAIT_MS. On exhaustion, invalidates cache and runs ONE fresh yt-dlp
# resolve with a YT_AD_GATE_RETRY_MAX_WAIT_MS window before falling back to pipe (5 min neg-cache).
YT_AD_GATE_POLL_MS=500
YT_AD_GATE_MAX_WAIT_MS=8000
YT_AD_GATE_RETRY_MAX_WAIT_MS=6000

# Set to 1 to automatically run a 3-way IPv4 probe comparison in server logs on any probe 403
# (never logs full URLs, signatures, or cookies). Also available on-demand via GET /api/admin/yt-debug-compare/:videoId.
YT_DEBUG_COMPARE=0

# Optional opt-in PO token provider (bgutil-ytdlp-pot-provider sidecar).
# Leave blank when not running the `pot` compose profile.
# To enable:
#   INSTALL_POT_PLUGIN=true
#   POT_PROVIDER_URL=http://bgutil-provider:4416
INSTALL_POT_PLUGIN=false
POT_PROVIDER_URL=